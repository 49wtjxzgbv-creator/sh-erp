[Unit]
Description=SH ERP procurement sourcing bot (Telegram, long-polling)
# Postgres runs via Docker even in the native systemd deployment path — same
# "app layer moved out of Docker, database didn't" shape as sh-erp-backend.
# Deliberately its OWN unit, decoupled from sh-erp-backend.service: a crash
# or bad deploy in this new, less-tested tool must never affect the core
# ERP API. Long-polling (no webhook, no Nginx route) — see
# backend/src/modules/sourcing-bot/sourcing-bot.module.ts's header comment
# for the full isolation rationale.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=shserp
Group=shserp
WorkingDirectory=/opt/sh-erp/backend
# Same codebase/deploy artifact as sh-erp-backend (one `dist/`), but its OWN
# env file — SOURCING_BOT_TELEGRAM_TOKEN is a DIFFERENT bot/token than
# TELEGRAM_BOT_TOKEN in backend.env, and SOURCING_BOT_DATABASE_URL is the
# narrow sourcing_bot_service role, not app_service. See
# /etc/sh-erp/sourcing-bot.env.example for the full list.
EnvironmentFile=/etc/sh-erp/sourcing-bot.env
ExecStart=/usr/bin/node dist/modules/sourcing-bot/main.js
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sh-erp-sourcing-bot
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
