# /etc/sh-erp/sourcing-bot.env — EnvironmentFile for sh-erp-sourcing-bot.service.
# Copy this template, fill in real values, then:
#   chown root:shserp /etc/sh-erp/sourcing-bot.env && chmod 640 /etc/sh-erp/sourcing-bot.env
#
# Deliberately a SEPARATE file from backend.env/frontend.env, matching the
# "one EnvironmentFile per unit" convention — even though this process
# shares the same `dist/` build as sh-erp-backend, it is its own systemd
# unit with its own crash/restart domain (see
# backend/src/modules/sourcing-bot/sourcing-bot.module.ts's header comment
# for why).

# Same tenant-respecting app_service connection the main backend uses —
# normal RLS-scoped reads/writes once a companyId is known
# (PrismaService#runInTenantTransaction), same as every other module.
DATABASE_URL="postgresql://app_user:changeme@localhost:5432/sh_erp?schema=public"

# A DIFFERENT Telegram bot/token than TELEGRAM_BOT_TOKEN in backend.env —
# create a new bot via @BotFather (NOT the same bot the production-
# notifications flow uses). Long-polling, so no webhook/secret needed here.
SOURCING_BOT_TELEGRAM_TOKEN=""

# This bot's sourcing data lives entirely in ONE company — required, not
# auto-detected from "which company does this user belong to" (this ERP
# installation hosts several legally-separate businesses sharing one
# install, and a staff member can hold membership in more than one — see
# SourcingIdentityService#getTargetCompanyId's own comment). Find the right
# company's id via its `slug` in the companies table.
SOURCING_BOT_COMPANY_ID=""

# BYPASSRLS role, narrow like TELEGRAM_BOT_DATABASE_URL in backend.env but
# its OWN role (sourcing_bot_service, not telegram_bot_service) — grants
# SELECT+UPDATE on users only, SELECT on company_memberships/companies. See
# backend/src/prisma/sourcing-bot-prisma.service.ts,
# prisma/migrations/20261109180000_procurement_sourcing_bot. Falls back to
# DATABASE_URL/app_user if unset, which will fail under real RLS — do not
# leave unset in production.
SOURCING_BOT_DATABASE_URL="postgresql://sourcing_bot_service:changeme@localhost:5432/sh_erp?schema=public"

# Same R2 bucket/credentials as backend.env — FilesService (reused here to
# send a product's PRODUCT_PHOTO) needs its own copy of these in THIS
# process's env, since they're not inherited from backend.env. Found live
# (2026-11-09): omitting these doesn't error at startup — createR2Client()
# silently falls back to empty-string credentials — it only surfaces later
# as Telegram's sendPhoto failing with "Bad Request: failed to get HTTP
# URL content" (the presigned URL points at the wrong/unauthenticated host).
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Mini App HTTP API (2026-11-10 — "веб версію як застосунок"). This process
# now ALSO listens on this port (see sourcing-bot/main.ts's header comment)
# for the Mini App frontend's (frontend/app/sourcing-app/) API calls — only
# Nginx should ever reach it (bind is Node's default, all interfaces;
# firewall/Nginx is what actually restricts this in practice, same as every
# other native-deploy process in this repo). Defaults to 3003 if unset.
SOURCING_APP_PORT="3003"

# Same public frontend origin as backend.env's own FRONTEND_URL — used here
# only for CORS (the Mini App page itself calls this API cross-origin from
# that domain). No credentials/cookies involved, so unlike the main
# backend this fails OPEN (not closed) if left unset in a non-production
# NODE_ENV — matches this repo's other local-dev-only permissive defaults.
FRONTEND_URL=""
