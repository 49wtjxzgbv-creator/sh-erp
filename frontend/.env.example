# Base URL of the NestJS backend API, including the /api/v1 prefix
# (backend/src/main.ts sets globalPrefix 'api' + URI versioning '1').
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Used only by the Next.js-owned app/api/auth/* route handlers when they
# proxy to the backend server-side (same value as above in local dev; in
# production this can point at an internal/private URL while
# NEXT_PUBLIC_API_BASE_URL points at the public one).
INTERNAL_API_BASE_URL=http://localhost:3000/api/v1

# Real gap found during the pre-Hostinger-launch audit: read by
# lib/auth/server-cookies.ts to set the httpOnly refresh-token cookie's own
# expiry, but was never documented here (only NEXT_PUBLIC_API_BASE_URL and
# INTERNAL_API_BASE_URL were). Falls back to 30 if unset, matching the
# backend's own default (backend/.env.example's JWT_REFRESH_TTL_DAYS) — so
# this was never a hard-broken-if-unset gap like the R2/FRONTEND_URL ones
# were, but MUST be kept in sync with the backend's real value if that's
# ever changed from 30, or the cookie's lifetime and the actual refresh
# token's lifetime silently drift apart (the backend still independently
# validates the token either way, so this is a UX/session-length
# correctness issue, not a security gap, if the two values ever disagree).
JWT_REFRESH_TTL_DAYS=30
