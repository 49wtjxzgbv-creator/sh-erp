# Postgres connection (Phase 3 schema — see /prisma/schema.prisma one directory up)
DATABASE_URL="postgresql://app_user:changeme@localhost:5432/sh_erp?schema=public"

# Superuser connection, used ONLY by ops/deploy.sh for `prisma migrate
# deploy`/`prisma db seed` — never by the running application. app_user
# deliberately lacks CREATEROLE (database-schema.md §2's least-privilege
# requirement), but the auth_service- and super_admin_service-creating
# migrations both run a real `CREATE ROLE`, which needs it. Not read by
# main.ts at all — deploy.sh exports this into its own shell just before
# the two Prisma commands that need it, then the actual systemd service
# runs with DATABASE_URL (app_user) as usual. See docs/deployment.md's
# "app_user/postgres role split" section for the full rationale.
MIGRATION_DATABASE_URL="postgresql://postgres:changeme@localhost:5432/sh_erp?schema=public"

# APPROVED (ADR-0009) — a distinct, narrowly-scoped, BYPASSRLS role for the
# handful of pre-tenant-context lookups login/refresh/company-discovery
# need (see src/prisma/auth-prisma.service.ts and
# prisma/migrations/20260804000000_create_auth_service_role/migration.sql).
# Falls back to DATABASE_URL/app_user if unset, which will fail under real
# RLS — do not leave unset in production. See database-schema.md §2c.
AUTH_DATABASE_URL="postgresql://auth_service:changeme@localhost:5432/sh_erp?schema=public"

# JWT (ADR-0006 — short-lived access token + rotating refresh token)
JWT_ACCESS_SECRET="changeme-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# App
PORT="3000"
NODE_ENV="development"

# CORS (see src/main.ts's enableCors call — real gap found and fixed during
# the production-readiness / deployment-documentation pass: the frontend
# calls this API straight from the browser for every module except the 3
# Next-owned auth routes, which is a genuine cross-origin request once
# frontend (Vercel) and backend (Railway) are on different origins; this
# app previously had no CORS configuration at all). Comma-separated list of
# allowed origins, e.g. "https://app.sh-erp.com,https://staging.sh-erp.com".
# Left unset here (dev default): permissive reflect-any-origin behavior,
# fine for local curl/Postman/localhost use. MUST be set in every deployed
# environment — see docs/deployment.md's env-var checklist.
FRONTEND_URL=""

# app_user must NOT be a superuser and must NOT have BYPASSRLS — see
# database-schema.md §2 ("Deployment requirement, made explicit after the
# architecture review"). RLS silently does nothing if this is violated.

# AI (Module 11, Phase 2 §8) — provider-abstracted; GeminiAdapter is the
# only implementation so far. Model reference stays an ALIAS on purpose
# (Phase 1 §3.7/§10.12: pinned Gemini versions have gone stale before).
AI_MODEL_ALIAS="gemini-flash-latest"
# Platform-provided key, used when a company hasn't set its own
# (CompanyAiSettings.apiKeyEncrypted, see src/modules/ai/ai-settings.service.ts).
AI_PLATFORM_API_KEY=""
# Envelope-encryption secret for a company's bring-your-own key — see
# src/modules/ai/ai-crypto.util.ts's header comment for what this is and
# is NOT (real KMS is a documented future upgrade, not implemented here).
# Required only if any company actually sets a BYOK key.
AI_API_KEY_ENCRYPTION_SECRET="changeme-ai-key-encryption-secret"

# Notifications (Module 12) — SMTP for the low-stock digest
# (src/modules/notifications/email.service.ts). If SMTP_HOST is unset,
# sending logs the message instead of throwing (fails open — see that
# file's header comment).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SH ERP <no-reply@sh-erp.local>"

# Files (Module 2, Phase 2 §7 / ADR-0004) — Cloudflare R2, S3-compatible,
# chosen over S3 itself for zero egress fees (see src/modules/files/r2-client.ts).
# Real env vars this backend reads at runtime — found missing from this file
# during the production-readiness documentation pass and added here rather
# than left undocumented; every file-upload/download/attachment feature
# (product photos, assembly drawings, QC photos, AI invoice recognition
# attachments, etc.) is unusable without these set.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="sh-erp-files"

# Super Admin (SuperAdminModule, added during the 2026-08-05 production-
# readiness audit) — a genuinely separate global role from Company Admin,
# with its OWN JWT secret. MUST differ from JWT_ACCESS_SECRET — reusing
# the same value would let a regular user's access token double as a
# super-admin token in principle (they're structurally different payloads,
# but signing with the same secret is the actual property that matters and
# must never be shared). Never falls back to JWT_ACCESS_SECRET if unset —
# SuperAdminGuard fails closed (all Super Admin routes return 401) rather
# than silently reusing the regular secret.
SUPER_ADMIN_JWT_SECRET="changeme-super-admin-jwt-secret-must-differ-from-jwt-access-secret"
SUPER_ADMIN_JWT_TTL="30m"

# BYPASSRLS role for cross-company Super Admin reads/writes (ADR-0010,
# prisma/migrations/20260805100000_add_super_admin). Falls back to
# DATABASE_URL/app_user if unset, which will silently see zero rows under
# real RLS for every Super Admin endpoint — do not leave unset in
# production.
SUPER_ADMIN_DATABASE_URL="postgresql://super_admin_service:changeme@localhost:5432/sh_erp?schema=public"

# Bootstraps exactly one Super Admin account on `prisma db seed`
# (prisma/seed.ts's seedSuperAdmin()) — set both to create it automatically,
# no manual SQL insert. Idempotent: re-running the seed with the same email
# never resets an already-changed password unless
# SUPER_ADMIN_BOOTSTRAP_FORCE_PASSWORD_RESET=true is also set for that one
# deploy. Leave both unset to skip Super Admin bootstrap entirely (the seed
# logs a message and continues — permissions/plans still get seeded).
SUPER_ADMIN_BOOTSTRAP_EMAIL=""
SUPER_ADMIN_BOOTSTRAP_PASSWORD=""
SUPER_ADMIN_BOOTSTRAP_FORCE_PASSWORD_RESET="false"

# Native (non-Docker) Hostinger VPS deployment (docs/deployment.md) — the
# host/interface main.ts binds to. Defaults to 0.0.0.0 (unset) for
# backwards compatibility with the Docker/Railway paths, where the
# container's/platform's own network boundary is what actually restricts
# public exposure. Set to 127.0.0.1 for the native systemd path — Nginx is
# then the ONLY thing that can reach this process at all, matching the
# same "bound to 127.0.0.1 only" principle docker-compose.prod.yml already
# uses for its containers.
HOST=""
