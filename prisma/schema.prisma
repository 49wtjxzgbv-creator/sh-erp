enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model PayrollEntry {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  employeeId        String   @db.Uuid
  type              PayrollEntryType
  productionOrderId String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)
  unitsProduced     Decimal? @db.Decimal(14, 3)
  amount            Decimal  @db.Decimal(14, 2) // signed: advances/penalties negative, bonuses/piecework positive (Phase 1 §2 convention, preserved)
  entryDate         DateTime @default(now()) @db.Timestamptz(3)
  comment           String?
  createdById       String   @db.Uuid

  legacyId          String?

  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  // immutable ledger — no updatedAt/deletedAt; a correction is a new entry, not an edit

  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee          Employee         @relation(fields: [companyId, employeeId], references: [companyId, id]) // composite — kept Restrict (default): a payroll ledger entry must always trace back to a real employee
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId])
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("payroll_entries")
}

enum PayrollEntryType {
  PIECEWORK
  ADVANCE
  BONUS
  PENALTY
}

// ============================================================================
// SECTION: Settings & Branding  (module: SettingsModule) — Settings.gs, Branding.gs
// ============================================================================

// One row per company — discrete typed columns, not a generic key/value
// sheet (the old Settings sheet's shape) now that every known setting is
// enumerable; DashboardWidgets stays a Json array deliberately (Phase 2
// §2.1 note: it's a simple ordered list of enum-like strings, not a hidden
// relational entity — a legitimate, narrow jsonb use, unlike the blobs
// normalized away elsewhere in this schema).
model CompanySettings {
  companyId           String   @id @db.Uuid
  vatRatePercent       Decimal  @default(20) @db.Decimal(5, 2)
  dashboardWidgets     Json     @default("[]")
  dailyDigestEmail     String?
  dailyDigestEnabled   Boolean  @default(false)

  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  company              Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("company_settings")
}

model CompanyBranding {
  companyId       String   @id @db.Uuid
  siteLogoFileId  String?  @db.Uuid
  printLogoFileId String?  @db.Uuid
  faviconFileId   String?  @db.Uuid

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  company         Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("company_branding")
}

// ============================================================================
// SECTION: AI  (module: AiModule) — Gemini.gs, AI_FullAssistant.gs
// ============================================================================

model CompanyAiSettings {
  companyId          String   @id @db.Uuid
  apiKeyEncrypted     String?  // present only if the company brings their own key (Phase 2 §8); null = platform-provided, metered
  monthlyUsageQuota   Int?

  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  company             Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("company_ai_settings")
}

// Durable replacement for the old in-memory/token-based confirmation flow
// (Phase 1 §3.7's confirmAiAction, Phase 2 §8) — survives a page refresh or
// API pod restart.
model PendingAiAction {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  userId       String   @db.Uuid
  actionKey    String   // e.g. "adjustProductStock"
  args         Json
  description  String
  status       PendingAiActionStatus @default(PENDING)

  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)
  resolvedAt   DateTime? @db.Timestamptz(3)

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@map("pending_ai_actions")
}

enum PendingAiActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model AiUsageLog {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  userId       String   @db.Uuid
  feature      String   // e.g. "full-assistant", "invoice-ocr", "help-assistant"
  tokensUsed   Int?
  costEstimate Decimal? @db.Decimal(10, 4)

  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@map("ai_usage_logs")
}

// ============================================================================
// SECTION: Billing  (module: BillingModule, stub — Phase 0: architecture
// ready, Stripe integration not implemented yet)
// ============================================================================

model Plan {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique // e.g. "starter", "growth", "enterprise"
  name          String
  monthlyPriceEur Decimal @db.Decimal(10, 2)
  limits        Json     // e.g. { "maxUsers": 10, "maxProducts": 5000 } — deliberately flexible, plan limits are inherently varied and non-relational

  subscriptions CompanySubscription[]

  @@map("plans")
}

model CompanySubscription {
  companyId          String   @id @db.Uuid
  planId             String   @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  stripeCustomerId   String?  // null until Stripe integration is actually wired up
  stripeSubscriptionId String?
  currentPeriodEnd   DateTime? @db.Timestamptz(3)

  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  company            Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan               Plan    @relation(fields: [planId], references: [id]) // Plan is global — no composite FK

  @@map("company_subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

// ============================================================================
// SECTION: Migration tracking  (Phase 4 tooling support — not a business module)
// ============================================================================

model LegacyMigrationRun {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  status           MigrationRunStatus @default(EXTRACTING)
  sourceDeploymentId String? // old Apps Script deployment identifier
  reconciliationReport Json?  // row counts, sum checks, checksum results (Phase 2 §12.5)
  startedAt        DateTime @default(now()) @db.Timestamptz(3)
  completedAt      DateTime? @db.Timestamptz(3)

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("legacy_migration_runs")
}

enum MigrationRunStatus {
  EXTRACTING
  TRANSFORMING
  LOADING
  VERIFYING
  COMPLETED
  FAILED
}
