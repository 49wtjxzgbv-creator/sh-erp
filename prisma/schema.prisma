enum PendingAiActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model AiUsageLog {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  userId       String   @db.Uuid
  feature      String // e.g. "full-assistant", "invoice-ocr", "help-assistant"
