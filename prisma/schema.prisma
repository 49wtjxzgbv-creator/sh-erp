// ============================================================================
// SH ERP v2 — Prisma schema (Phase 3 deliverable, revised after the Phase 3
// architecture review + 5 finalized owner decisions, 2026-08-04)
//
// Conventions applied throughout (see database-schema.md for the full
// rationale and the companion RLS/CHECK-constraint SQL, which Prisma cannot
// express natively and is applied via a raw-SQL migration):
//   - Every tenant-scoped model has `companyId String @db.Uuid` as its FIRST
//     field after `id`, indexed first in every composite index (Phase 2 §11.3).
//   - Primary keys are UUIDs, never sequential integers (Phase 2 §16 — keeps
//     partitioning and horizontal scaling options open, avoids leaking row
//     counts, safe to generate client-side if ever needed).
//   - `legacyId` (nullable) is present on every model that can originate from
//     the Google Sheets migration (Phase 2 §12) — preserves the old UUID/
//     serial-number for support traceability.
//   - `createdAt`/`updatedAt` on every model; `createdById`/`updatedById`
//     where "who did this" matters beyond what the AuditEvent log captures.
//   - `deletedAt` (soft delete) on models where deletion is a real, reversible
//     user action. Append-only ledgers (AuditEvent, StockMovement,
//     AssemblyVersion, PayrollEntry) are never soft-deleted — they are
//     immutable by design, mirroring the old History sheet's guarantee
//     (Phase 1 §10... "no delete function exists for this sheet, ever"),
//     now enforced by a DB grant (see database-schema.md) rather than by
//     omission.
//   - Money is `Decimal @db.Decimal(14, 2)`, never Float — the old system's
//     raw JS float arithmetic on EUR amounts (with a `round2_()` helper
//     papering over precision drift) is explicitly NOT migrated forward
//     (Phase 1 §1.4, §10.8 documents a real production incident caused by
//     this class of problem).
//   - Every `DateTime` field is `@db.Timestamptz(3)` — Prisma's PostgreSQL
//     default is timezone-naive, which is a real correctness risk given
//     `Company.timezone` already varies per tenant (Phase 3 review finding).
//   - Every enum used for a "status" field mirrors the exact status values
//     documented in Phase 1's data dictionary — no silent renaming.
//   - Models are grouped into commented sections matching the Phase 2 §2.1
//     NestJS module map, supporting the plugin-oriented convention from
//     Phase 2 §18 (each module's models live in one clearly delimited
//     section of this file).
//
//   - CROSS-TENANT REFERENTIAL INTEGRITY (Phase 3 review, decision 4 —
//     composite foreign keys): every REQUIRED relation between two
//     tenant-scoped sibling models (e.g. WarehouseStock -> Product) uses a
//     composite foreign key `fields: [companyId, xId], references: [companyId, id]`
//     instead of a plain `id`-only FK. This makes it structurally impossible
//     at the database layer for a row to reference another tenant's entity —
//     a plain single-column FK only checks "does this id exist," not "does
//     it belong to the same company." Models that are the target of at least
//     one composite relation carry an extra `@@unique([companyId, id])` to
//     serve as the composite key's target.
//     LIMITATION, disclosed rather than glossed over: Prisma requires that
//     for a relation field to be optional, every scalar field listed in its
//     `fields: [...]` must also be optional. Since `companyId` is never
//     optional on a tenant-scoped model, this rule makes composite FKs
//     impossible for OPTIONAL cross-tenant relations (e.g.
//     `Product.defaultSupplierId`, `StockMovement.warehouseId`,
//     `AssemblyComponent.productId`/`subAssemblyId`/`warehouseId`,
//     `PurchaseOrder.supplierId`, etc.). Those remain single-column FKs,
//     each marked with a `// single-column FK — see header §cross-tenant`
//     comment, and stay covered by the app-layer Prisma Client Extension
//     (Phase 2 §11.4) rather than a DB-level composite guarantee. This is a
//     deliberate, disclosed scope boundary, not an oversight.
//
//   - DELETE POLICY (Phase 3 review, decision 5 — hybrid, explicit-where-clear):
//     `onDelete: Restrict` on every `company Company @relation` pointer
//     (explicit, even though it matches Prisma's implicit default) — company
//     removal is soft-delete-only (Phase 0), so a hard delete should never
//     silently cascade through a whole tenant's data.
//     `onDelete: Cascade` on relations from a pure child/expansion table to
//     its parent (e.g. ProductionOrderPickListItem -> ProductionOrder) —
//     these rows have no independent meaning without their parent.
//     `onDelete: SetNull` on optional/soft-reference relations (e.g.
//     Product.defaultSupplier, Shipment.customerOrder) — the reference
//     should not block, and should not cascade-delete, the referencing row.
//     Everything else is left at Prisma's implicit default (effectively
//     Restrict) — this is the "hybrid" scope agreed with the owner: a
//     lightweight default posture now, confirmed or overridden per module
//     against real deletion UX during Phase 5, not 70+ relations
//     individually re-litigated up front.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // required for citext (decision 3 — case-insensitive article/email/login)
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ============================================================================
// SECTION: Tenancy & Identity  (module: TenancyModule, IdentityModule, AuthorizationModule)
// ============================================================================

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique // subdomain: {slug}.sh-erp.com — UX resolution only, never trusted for auth (ADR-0002)
  name      String
  status    CompanyStatus @default(ACTIVE)
  timezone  String   @default("Europe/Kyiv")
  locale    String   @default("uk") // default UI language for this company (Phase 2 §3.6)

  legacyId  String?  @unique // old Apps Script deployment identifier, if migrated — Company IS the tenant root (no companyId field to scope by), so this is a plain global unique rather than the [companyId, legacyId] pattern used elsewhere (Phase 4 decision)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3) // soft-disable on offboarding (Phase 2 §11.5), never a hard delete

  memberships       CompanyMembership[]
  roles             Role[]
  settings          CompanySettings?
  branding          CompanyBranding?
  aiSettings        CompanyAiSettings?
  subscription      CompanySubscription?
  featureFlagOverrides CompanyFeatureFlagOverride[]

  // Back-relations for every tenant-scoped domain model below — required by
  // Prisma for explicit foreign-key relations (both sides must be declared),
  // and genuinely useful in practice (typed `include`, cascading admin
  // tooling, company-level counts) despite the length of this list.
  products          Product[]
  units             CompanyUnit[]
  suppliers         Supplier[]
  warehouses        Warehouse[]
  warehouseStocks   WarehouseStock[]
  stockMovements    StockMovement[]
  inventorySessions InventorySession[]
  inventoryItems    InventoryItem[]
  assemblies        Assembly[]
  productionStages  ProductionStage[]
  productionOrders  ProductionOrder[]
  finishedGoods     FinishedGood[]
  qcChecklistItems  QcChecklistItem[]
  qcChecks          QcCheck[]
  qcCheckResults    QcCheckResult[]
  customerOrders    CustomerOrder[]
  customerOrderItems CustomerOrderItem[]
  shipments         Shipment[]
  shipmentItems     ShipmentItem[]
  purchaseOrders    PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  employees         Employee[]
  payrollEntries    PayrollEntry[]
  fileAssets        FileAsset[]
  pendingAiActions  PendingAiAction[]
  aiUsageLogs       AiUsageLog[]
  legacyMigrationRuns LegacyMigrationRun[]
  assemblyComponents AssemblyComponent[]
  assemblyVersions  AssemblyVersion[]
  assemblyVersionComponents AssemblyVersionComponent[]
  productionOrderPickListItems ProductionOrderPickListItem[]
  productionOrderStageEvents ProductionOrderStageEvent[]
  productionOrderWorkers ProductionOrderWorker[]

  @@map("companies")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique @db.Citext // case-insensitive (decision 3) — "a@b.com" and "A@B.com" are the same account
  login             String?  @unique @db.Citext // preserves old-style username login alongside email (Phase 1 §1.2), also case-insensitive
  fullName          String
  passwordHash      String?  // argon2id — new accounts and post-re-hash migrated accounts
  legacyPasswordHash String? // unsalted SHA-256, present ONLY until first successful transparent re-hash (ADR-0006 / Phase 0)
  mfaSecret         String?  // TOTP secret, unused at launch — schema field exists so enabling MFA later needs no migration (Phase 2 §5.7)
  mfaEnabled        Boolean  @default(false)
  active            Boolean  @default(true)

  legacyId          String? // NOT unique-constrained, deliberately (Phase 4 decision): User is global, not company-scoped, and a local legacy row id from one company's spreadsheet has no guarantee of not colliding with another company's local legacy row id — a plain global unique here would be actively wrong. Migration load idempotency for User keys off `email` (already globally unique via citext) instead.

  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  memberships       CompanyMembership[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

// User is NOT tenant-scoped (a single account can belong to multiple
// companies via multiple memberships), so relations to User are never
// composite — there is no "wrong tenant" concept for a global entity.
model CompanyMembership {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [companyId, roleId], references: [companyId, id]) // composite — Role is tenant-scoped

  @@unique([companyId, userId]) // one active role per user per company
  @@index([companyId])
  @@index([userId])
  @@map("company_memberships")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false) // true for the 5 seeded default roles (Phase 2 §6) — cannot be deleted, can still have permissions edited

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships CompanyMembership[]

  @@unique([companyId, name])
  @@unique([companyId, id]) // composite-FK target for CompanyMembership.role
  @@index([companyId])
  @@map("roles")
}

// Fixed catalogue, NOT company-scoped — permissions correspond to real
// enforcement points in code (Phase 2 §6). Grows only when a feature that
// needs a new enforcement point ships. Never a composite-FK target: it's
// global, so there's no "wrong tenant" for a Permission reference either.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. "products:write", "payroll:manage", "ai:use-critical-actions"
  resource    String   // e.g. "products"
  action      String   // e.g. "write"
  description String

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  companyId     String   @db.Uuid // token is scoped to one company session, even for multi-company users
  tokenHash     String   @unique // never store the raw token
  familyId      String   @db.Uuid // rotation family — reuse of a revoked token in this family revokes the whole family (ADR-0006)
  device        String?
  ipAddress     String?
  expiresAt     DateTime @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)

  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  user          User     @relation(fields: [userId], references: [id]) // User is global — no composite FK

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt]) // cleanup job: purge expired/revoked tokens
  @@map("refresh_tokens")
}

// ============================================================================
// SECTION: Global System Administration  (module: SuperAdminModule)
//
// Added during the production-readiness audit (2026-08-05) per an explicit
// owner requirement: a genuinely separate, global "system operator" role,
// distinct from Company Admin (a per-company Role row, tenant-scoped like
// everything else in Authorization). Deliberately its OWN model, not a flag
// on `User` — a super admin is not a member of any company, has no
// `CompanyMembership`/`Role`, and must keep working even for a company
// whose own admin user is locked out or deleted. Authenticated with its own
// JWT (signed with `SUPER_ADMIN_JWT_SECRET`, never `JWT_ACCESS_SECRET`) via
// SuperAdminAuthService — a super admin token and a regular access token
// are not interchangeable in either direction. Data access crosses tenant
// boundaries by design (see all companies, all users), so it reads through
// a separate BYPASSRLS role (`super_admin_service`, see the migration
// alongside this schema change) — never through `app_user`'s RLS-bound
// connection, and never through `auth_service` either (ADR-0009's role is
// narrowly scoped to 3 pre-tenant-context auth flows and stays that way;
// overloading it here would blur a boundary that was deliberately drawn
// tight — see ADR-0010 for the new role's own rationale).
// ============================================================================

model SuperAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    // argon2id, same algorithm as User — no reason to use a weaker one here
  fullName     String
  active       Boolean   @default(true) // deactivate instead of delete — keeps SuperAdminAuditLog attributable
  lastLoginAt  DateTime? @db.Timestamptz(3)

  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  auditLogs    SuperAdminAuditLog[]

  @@map("super_admins")
}

// Append-only, mirroring AuditEvent's own "corrections are new state, never
// erasure" convention below — but a SEPARATE table, not a reuse of
// AuditEvent, because a super-admin action (blocking a company, changing
// its plan, impersonating a user) often has no single `companyId` it
// belongs to, and AuditEvent.companyId is required/RLS-scoped by design.
model SuperAdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  superAdminId String   @db.Uuid
  action       String   // e.g. "company.blocked", "company.impersonated", "plan.updated"
  targetType   String?  // e.g. "Company", "Plan", "SuperAdmin"
  targetId     String?
  metadata     Json?

  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id])

  @@index([superAdminId])
  @@index([targetType, targetId])
  @@map("super_admin_audit_log")
}

// ============================================================================
// SECTION: Audit  (module: AuditModule) — replaces the old append-only History sheet
// ============================================================================

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  actorUserId  String?  @db.Uuid // null for system/job-initiated events
  action       String   // e.g. "production_order.started", "product.price_changed"
  entityType   String   // e.g. "ProductionOrder"
  entityId     String   @db.Uuid
  before       Json?
  after        Json?
  metadata     Json?    // free-form context (comment, ip, request id) — the ONE deliberate jsonb use here, because this is genuinely unstructured, per-event-type data, not a hidden relational table (contrast with the old PickListJson/StageHistoryJson pattern this schema explicitly normalizes away elsewhere)

  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  // No updatedAt, no deletedAt — immutable by design, DB-grant-enforced (database-schema.md)

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@map("audit_events")
}

// ============================================================================
// SECTION: Feature Flags  (module: FeatureFlagsModule, Phase 2 §19)
// ============================================================================

model FeatureFlag {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  description  String
  defaultOn    Boolean  @default(false)

  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  overrides    CompanyFeatureFlagOverride[]

  @@map("feature_flags")
}

model CompanyFeatureFlagOverride {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  featureFlagId String   @db.Uuid
  enabled       Boolean

  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id]) // FeatureFlag is global — no composite FK

  @@unique([companyId, featureFlagId])
  @@index([companyId])
  @@map("company_feature_flag_overrides")
}

// ============================================================================
// SECTION: Files  (module: FilesModule, Phase 2 §7) — generic attachment
// record, replaces the old scattered *Url string columns per entity.
// ============================================================================

model FileAsset {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  domain       FileDomain
  entityType   String   // e.g. "Product", "Assembly"
  entityId     String   @db.Uuid
  storageKey   String   // R2 object key (Phase 2 §7 layout)
  originalName String
  mimeType     String
  sizeBytes    Int
  isPublic     Boolean  @default(false) // true for branding assets shown pre-login

  uploadedById String?  @db.Uuid
  legacyId     String?  // old Drive file ID, for migration traceability

  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, entityType, entityId])
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("file_assets")
}

enum FileDomain {
  PRODUCT_PHOTO
  ASSEMBLY_PHOTO
  ASSEMBLY_DRAWING
  CUSTOMER_ORDER_DOCUMENT
  PURCHASE_INVOICE
  EMPLOYEE_PHOTO
  QC_PHOTO
  SHIPMENT_PHOTO
  BRANDING
}

// ============================================================================
// SECTION: Catalog  (module: CatalogModule) — Products.gs, ImportExport.gs, Labels.gs
// ============================================================================

model Product {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @db.Uuid

  article               String   @db.Citext // unique business key, case-insensitive within a company (decision 3 — now DB-enforced)
  code                  String?
  name                  String
  description           String?
  category              String?
  productGroup          String?
  family                String?
  type                  String?
  kind                  String?
  productLine           String?
  barcode               String?

  unitId                String   @db.Uuid // FK to CompanyUnit (decision 1) — replaces the old free-text `unit` column
  unitsPerPackage       Decimal? @db.Decimal(14, 3)
  cell                  String?
  qty                   Decimal  @default(0) @db.Decimal(14, 3)
  minQty                Decimal  @default(0) @db.Decimal(14, 3)

  localPriceExclVat     Decimal? @db.Decimal(14, 2)
  localPriceInclVat     Decimal? @db.Decimal(14, 2)
  germanPriceExclVat    Decimal? @db.Decimal(14, 2)
  germanPriceInclVat    Decimal? @db.Decimal(14, 2)
  sellPriceEur          Decimal? @db.Decimal(14, 2)

  weightPerUnitKg       Decimal? @db.Decimal(10, 3)
  warrantyMonths        String?
  status                String?
  manufacturer          String?
  manufacturerCode      String?
  countryOfOrigin       String?
  priceListRef          String?
  note                  String?

  defaultSupplierId     String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)

  legacyId              String?

  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime? @db.Timestamptz(3)

  company               Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  unit                  CompanyUnit @relation(fields: [companyId, unitId], references: [companyId, id]) // composite
  defaultSupplier       Supplier?   @relation(fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  assemblyComponents    AssemblyComponent[]
  stockMovements        StockMovement[]
  warehouseStocks       WarehouseStock[]
  inventoryItems        InventoryItem[]
  purchaseOrderItems    PurchaseOrderItem[]

  @@unique([companyId, article])
  @@unique([companyId, id]) // composite-FK target for WarehouseStock/StockMovement/InventoryItem
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@index([companyId, category])
  @@index([companyId, name])
  @@index([companyId, barcode])
  @@index([companyId, unitId])
  @@map("products")
}

model CompanyUnit {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products  Product[]

  @@unique([companyId, name])
  @@unique([companyId, id]) // composite-FK target for Product.unit
  @@map("company_units")
}

// ============================================================================
// SECTION: Procurement — Suppliers  (module: ProcurementModule) — Suppliers.gs
// (declared here, ahead of Inventory, because Product.defaultSupplier references it)
// ============================================================================

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  name          String
  contactPerson String?
  phone         String?
  email         String?
  notes         String?

  legacyId      String?

  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products           Product[]
  assemblies         Assembly[]
  purchaseOrders     PurchaseOrder[]

  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@index([companyId])
  @@map("suppliers")
}

// ============================================================================
// SECTION: Inventory  (module: InventoryModule) — Warehouse.gs, Warehouses.gs, InventorySessions.gs
// ============================================================================

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  isDefault Boolean  @default(false)

  legacyId  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  company             Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stocks              WarehouseStock[]
  movements           StockMovement[]
  assemblyComponents  AssemblyComponent[]

  @@index([companyId])
  @@unique([companyId, id]) // composite-FK target for WarehouseStock.warehouse
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("warehouses")
}

// Explicit allocation per (product, warehouse) — INCLUDING the default
// warehouse, unlike the old system where the default warehouse's quantity
// was always an implicit remainder never stored anywhere (Phase 1 §6.6,
// flagged there as "a view, not a ledger"). Migration (Phase 2 §12.2)
// computes and materializes that old implicit remainder into real rows here.
model WarehouseStock {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  productId   String   @db.Uuid
  warehouseId String   @db.Uuid
  qty         Decimal  @default(0) @db.Decimal(14, 3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [companyId, productId], references: [companyId, id]) // composite
  warehouse   Warehouse @relation(fields: [companyId, warehouseId], references: [companyId, id]) // composite

  @@unique([companyId, productId, warehouseId]) // leading companyId also serves as the tenant-scoped lookup index
  @@map("warehouse_stock")
}

// Structured, append-only stock ledger — the domain-specific counterpart to
// the generic AuditEvent log, giving real reporting queries (e.g. "total
// moved per article this month") a proper table instead of a text-parsed
// History sheet (Phase 1 §3.2's `getHistoryDerivedData_` pattern, done properly).
model StockMovement {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  productId   String   @db.Uuid
  warehouseId String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)
  type        StockMovementType
  qtyDelta    Decimal  @db.Decimal(14, 3) // signed
  qtyAfter    Decimal  @db.Decimal(14, 3)
  comment     String?
  actorUserId String?  @db.Uuid
  // polymorphic link to the order/session/etc. that caused this movement, if any
  sourceType  String?  // e.g. "ProductionOrder", "PurchaseOrder", "InventorySession"
  sourceId    String?  @db.Uuid

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  // immutable — no updatedAt/deletedAt, same guarantee as AuditEvent

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product     Product    @relation(fields: [companyId, productId], references: [companyId, id]) // composite
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([companyId, productId, createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  RECEIVE
  ISSUE
  ADJUST
  MOVE
  DEFECT_WRITE_OFF
  ASSEMBLY_CONSUMPTION
  PRODUCTION_CONSUMPTION
  INVENTORY_RECONCILIATION
}

model InventorySession {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  status      InventorySessionStatus @default(IN_PROGRESS)
  startedById String   @db.Uuid
  comment     String?

  legacyId    String?

  startedAt   DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items       InventoryItem[]

  @@index([companyId])
  @@unique([companyId, id]) // composite-FK target for InventoryItem.session
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("inventory_sessions")
}

enum InventorySessionStatus {
  IN_PROGRESS
  COMPLETED
}

model InventoryItem {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @db.Uuid
  inventorySessionId String   @db.Uuid
  productId          String   @db.Uuid
  expectedQty        Decimal  @db.Decimal(14, 3)
  actualQty          Decimal? @db.Decimal(14, 3)
  counted            Boolean  @default(false)

  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  session            InventorySession @relation(fields: [companyId, inventorySessionId], references: [companyId, id], onDelete: Cascade) // composite — a count line has no meaning without its session
  product            Product          @relation(fields: [companyId, productId], references: [companyId, id]) // composite

  @@index([inventorySessionId])
  @@index([companyId])
  @@map("inventory_items")
}

// ============================================================================
// SECTION: BOM  (module: BomModule) — Assemblies.gs
// ============================================================================

model Assembly {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @db.Uuid

  name                   String
  article                String?
  note                   String?

  laborCostPerUnit       Decimal  @default(0) @db.Decimal(14, 2)
  packagingCostPerUnit   Decimal  @default(0) @db.Decimal(14, 2)
  deliveryCostPerUnit    Decimal  @default(0) @db.Decimal(14, 2)
  otherCostPerUnit       Decimal  @default(0) @db.Decimal(14, 2)

  defaultSupplierId      String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)

  legacyId               String?

  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime? @db.Timestamptz(3)

  company                Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultSupplier        Supplier? @relation(fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  components             AssemblyComponent[]
  componentOfParents     AssemblyComponent[] @relation("SubAssembly")
  versions               AssemblyVersion[]
  productionOrders       ProductionOrder[]
  finishedGoods          FinishedGood[]
  customerOrderItems     CustomerOrderItem[]

  @@index([companyId])
  @@unique([companyId, id]) // composite-FK target for AssemblyComponent/AssemblyVersion/ProductionOrder/FinishedGood/CustomerOrderItem
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("assemblies")
}

// One row per BOM line. componentType discriminates product vs. nested
// assembly, exactly as AssemblyComponents.ComponentType did (Phase 1's data
// dictionary) — kept as a discriminated pair of nullable FKs rather than two
// separate join tables, because the recursive cost/shortage algorithms
// (Phase 1 §3.3, ported to BomModule) genuinely need to walk one unified list.
// componentType/productId/subAssemblyId consistency is enforced by a raw-SQL
// CHECK constraint (decision 2, see database-schema.md §2b) — Prisma has no
// declarative CHECK attribute, so it can't be expressed here.
model AssemblyComponent {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  assemblyId      String   @db.Uuid
  componentType   ComponentType
  productId       String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)
  subAssemblyId   String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)
  warehouseId     String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)
  qtyPerUnit      Decimal  @db.Decimal(14, 4)

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assembly        Assembly  @relation(fields: [companyId, assemblyId], references: [companyId, id], onDelete: Cascade) // composite — a BOM line has no meaning without its assembly
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  subAssembly     Assembly? @relation("SubAssembly", fields: [subAssemblyId], references: [id], onDelete: SetNull)
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([assemblyId])
  @@index([companyId])
  @@map("assembly_components")
}

enum ComponentType {
  PRODUCT
  ASSEMBLY
}

// Immutable BOM snapshot — one new row per saveAssembly call, never updated
// (Phase 1 §2's AssemblyVersions). ProductionOrder.bomVersionId locks onto
// a specific row here so a later BOM edit never retroactively changes an
// in-flight order (Phase 1 §6.4).
model AssemblyVersion {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  assemblyId    String   @db.Uuid
  versionNumber Int
  createdById   String   @db.Uuid

  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  // immutable — no updatedAt/deletedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assembly      Assembly @relation(fields: [companyId, assemblyId], references: [companyId, id]) // composite — kept Restrict (default): a BOM version is a permanent historical record, should not vanish just because the assembly is later deleted
  components    AssemblyVersionComponent[]
  productionOrders ProductionOrder[]

  @@unique([assemblyId, versionNumber])
  @@index([companyId])
  @@unique([companyId, id]) // composite-FK target for AssemblyVersionComponent.assemblyVersion
  @@map("assembly_versions")
}

// Expansion of the old ComponentsJson blob (Phase 1 §2/§10.4) into real rows.
// companyId denormalized from parent — see ProductionOrderPickListItem comment below.
// productId/subAssemblyId/warehouseId are deliberately NOT modeled as Prisma
// relations (same as ProductionOrderPickListItem.productId) — this is an
// immutable historical snapshot, so a later product/assembly/warehouse
// deletion must never be blocked by, or cascade into corrupting, old BOM
// history. componentType/productId/subAssemblyId consistency is still
// enforced by a raw-SQL CHECK constraint (decision 2, database-schema.md §2b).
model AssemblyVersionComponent {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  assemblyVersionId String   @db.Uuid
  componentType     ComponentType
  productId         String?  @db.Uuid
  subAssemblyId     String?  @db.Uuid
  warehouseId       String?  @db.Uuid
  qtyPerUnit        Decimal  @db.Decimal(14, 4)

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assemblyVersion   AssemblyVersion @relation(fields: [companyId, assemblyVersionId], references: [companyId, id], onDelete: Cascade) // composite — a BOM-version line has no meaning without its version

  @@index([assemblyVersionId])
  @@index([companyId])
  @@map("assembly_version_components")
}

// ============================================================================
// SECTION: Production  (module: ProductionModule) — ProductionOrders.gs,
// ProductionStages.gs, FinishedGoods.gs
// ============================================================================

model ProductionStage {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  sortOrder Int

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("production_stages")
}

model ProductionOrder {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @db.Uuid
  assemblyId          String   @db.Uuid
  assemblyVersionId   String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation; nullable only for pre-versioning legacy rows, Phase 1 §6.4)
  unitsPlanned        Decimal  @db.Decimal(14, 3)
  status              ProductionOrderStatus @default(PLANNED)
  createdById         String   @db.Uuid
  comment             String?

  currentStageIndex   Int?

  totalLocalCostEur   Decimal? @db.Decimal(14, 2)
  totalGermanCostEur  Decimal? @db.Decimal(14, 2)
  laborCostEur        Decimal? @db.Decimal(14, 2)
  packagingCostEur    Decimal? @db.Decimal(14, 2)
  deliveryCostEur     Decimal? @db.Decimal(14, 2)
  otherCostEur        Decimal? @db.Decimal(14, 2)
  fullCostEur         Decimal? @db.Decimal(14, 2)

  legacyId            String?

  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  completedAt         DateTime? @db.Timestamptz(3)

  company             Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assembly            Assembly         @relation(fields: [companyId, assemblyId], references: [companyId, id]) // composite — kept Restrict (default): can't delete an assembly with live production orders
  assemblyVersion     AssemblyVersion? @relation(fields: [assemblyVersionId], references: [id])
  pickListItems       ProductionOrderPickListItem[]
  stageEvents         ProductionOrderStageEvent[]
  workers             ProductionOrderWorker[]
  finishedGoods       FinishedGood[]
  payrollEntries      PayrollEntry[]
  customerOrderItem   CustomerOrderItem?

  @@index([companyId, status])
  @@unique([companyId, id]) // composite-FK target for pick-list/stage-event/worker children and FinishedGood.productionOrder
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("production_orders")
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Expansion of the old PickListJson blob (Phase 1 §2/§10.4).
// companyId is denormalized from productionOrder.companyId at write time
// (set by the same Prisma Client Extension that injects it on every tenant
// write, Phase 2 §11.4) — required so this table can carry its own RLS
// policy and its own (companyId, ...) index, same as every other
// tenant-scoped table, instead of needing a join-based policy (Phase 3
// review finding: this table originally had no companyId column at all).
// productId is deliberately NOT a Prisma relation — see AssemblyVersionComponent
// comment above for why snapshot/historical tables keep soft references.
model ProductionOrderPickListItem {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  productionOrderId String   @db.Uuid
  productId         String?  @db.Uuid // null for a "finished sub-assembly consumed" line
  description       String   // article/name snapshot at time of consumption
  qty               Decimal  @db.Decimal(14, 3)
  unitPriceEur      Decimal? @db.Decimal(14, 2)
  lineTotalEur      Decimal? @db.Decimal(14, 2)
  consumedFinishedGoodIds String[] // serials consumed, if this line is a sub-assembly (Phase 1's FIFO consumption)

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productionOrder   ProductionOrder @relation(fields: [companyId, productionOrderId], references: [companyId, id], onDelete: Cascade) // composite — a pick-list line has no meaning without its order

  @@index([productionOrderId])
  @@index([companyId])
  @@map("production_order_pick_list_items")
}

// Expansion of the old StageHistoryJson blob. companyId denormalized from
// parent — see ProductionOrderPickListItem comment above.
model ProductionOrderStageEvent {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  productionOrderId String   @db.Uuid
  stageIndex        Int
  actorUserId       String   @db.Uuid

  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productionOrder   ProductionOrder @relation(fields: [companyId, productionOrderId], references: [companyId, id], onDelete: Cascade) // composite — an audit event has no meaning without its order

  @@index([productionOrderId])
  @@index([companyId])
  @@map("production_order_stage_events")
}

// Expansion of the old AssignedWorkersJson blob. companyId denormalized from
// parent — see ProductionOrderPickListItem comment above. Unique constraint
// prevents the same employee being listed twice on one order (Phase 3
// review finding: previously unconstrained).
model ProductionOrderWorker {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  productionOrderId String   @db.Uuid
  employeeId        String   @db.Uuid
  percent           Decimal  @db.Decimal(5, 2) // normalized to sum to 100 across a given order's workers

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productionOrder   ProductionOrder @relation(fields: [companyId, productionOrderId], references: [companyId, id], onDelete: Cascade) // composite — a worker assignment has no meaning without its order
  employee          Employee        @relation(fields: [companyId, employeeId], references: [companyId, id]) // composite

  @@unique([productionOrderId, employeeId])
  @@index([companyId])
  @@map("production_order_workers")
}

model FinishedGood {
  id                          String   @id @default(uuid()) @db.Uuid
  companyId                   String   @db.Uuid
  serialNumber                String   @unique // "SN-000001" format preserved
  assemblyId                  String   @db.Uuid
  productionOrderId           String   @db.Uuid
  status                      FinishedGoodStatus @default(IN_STOCK)
  customerOrderId             String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)
  comment                     String?
  unitCostLocalEur            Decimal  @db.Decimal(14, 2)
  unitCostGermanEur           Decimal  @db.Decimal(14, 2)
  consumedInProductionOrderId String?  @db.Uuid // set when used as a sub-assembly component of a parent (Phase 1 FIFO consumption) — deliberately not a Prisma relation, same rationale as the other FIFO/snapshot fields

  legacyId                    String?

  manufactureDate             DateTime @default(now()) @db.Timestamptz(3)

  company                     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assembly                    Assembly        @relation(fields: [companyId, assemblyId], references: [companyId, id]) // composite — kept Restrict (default)
  productionOrder             ProductionOrder @relation(fields: [companyId, productionOrderId], references: [companyId, id]) // composite — kept Restrict (default): a finished good must always trace back to the order that made it
  customerOrder                CustomerOrder?  @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  qcChecks                    QcCheck[]
  shipmentItems                ShipmentItem[]

  @@index([companyId, status])
  @@index([companyId, assemblyId])
  @@index([customerOrderId])
  @@index([consumedInProductionOrderId])
  @@unique([companyId, id]) // composite-FK target for QcCheck.finishedGood/ShipmentItem.finishedGood
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("finished_goods")
}

enum FinishedGoodStatus {
  IN_STOCK
  SHIPPED
  CONSUMED
  REWORK
  DEFECTIVE
}

// ============================================================================
// SECTION: Quality  (module: QualityModule) — QualityControl.gs
// ============================================================================

model QcChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  sortOrder Int

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("qc_checklist_items")
}

model QcCheck {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  finishedGoodId String   @db.Uuid
  result         QcResult
  inspectorId    String   @db.Uuid
  comment        String?

  checkedAt      DateTime @default(now()) @db.Timestamptz(3)

  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  finishedGood   FinishedGood  @relation(fields: [companyId, finishedGoodId], references: [companyId, id]) // composite — kept Restrict (default): a QC check must always trace back to the finished good it inspected
  results        QcCheckResult[]

  @@index([companyId, finishedGoodId])
  @@unique([companyId, id]) // composite-FK target for QcCheckResult.qcCheck
  @@map("qc_checks")
}

enum QcResult {
  ACCEPTED
  REWORK
}

// Expansion of the old ChecklistJson blob. companyId denormalized from
// parent — see ProductionOrderPickListItem comment above.
model QcCheckResult {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  qcCheckId String  @db.Uuid
  itemName  String  // snapshot of the checklist item text at time of check
  passed    Boolean

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  qcCheck   QcCheck @relation(fields: [companyId, qcCheckId], references: [companyId, id], onDelete: Cascade) // composite — a checklist result has no meaning without its check

  @@index([qcCheckId])
  @@index([companyId])
  @@map("qc_check_results")
}

// ============================================================================
// SECTION: Sales  (module: SalesModule) — CustomerOrders.gs, Shipments.gs
// ============================================================================

model CustomerOrder {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  orderNumber    String?
  clientName     String
  contactPerson  String?
  deadline       DateTime? @db.Timestamptz(3)
  priority       CustomerOrderPriority @default(NORMAL)
  status         CustomerOrderStatus @default(NEW)
  comment        String?
  createdById    String   @db.Uuid

  legacyId       String?

  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  company        Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items          CustomerOrderItem[]
  finishedGoods  FinishedGood[]
  shipments      Shipment[]
  purchaseOrders PurchaseOrder[]

  @@index([companyId, status])
  @@unique([companyId, id]) // composite-FK target for CustomerOrderItem.customerOrder
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("customer_orders")
}

enum CustomerOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CustomerOrderStatus {
  NEW
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model CustomerOrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  customerOrderId   String   @db.Uuid
  assemblyId        String   @db.Uuid
  qty               Decimal  @db.Decimal(14, 3)
  productionOrderId String?  @db.Uuid @unique // single-column FK — see header §cross-tenant (optional relation); set once this line is "given to production" — enables staged production (Phase 1 §6.2)

  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customerOrder     CustomerOrder    @relation(fields: [companyId, customerOrderId], references: [companyId, id], onDelete: Cascade) // composite — an order line has no meaning without its order
  assembly          Assembly         @relation(fields: [companyId, assemblyId], references: [companyId, id]) // composite — kept Restrict (default)
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  @@index([customerOrderId])
  @@index([companyId])
  @@index([assemblyId])
  @@map("customer_order_items")
}

model Shipment {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  carrier         String?
  waybillNumber   String?
  packageCount    Int?
  weightKg        Decimal? @db.Decimal(10, 3)
  dimensions      String?
  status          ShipmentStatus @default(SHIPPED)
  customerOrderId String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)
  comment         String?
  createdById     String   @db.Uuid

  legacyId        String?

  shipDate        DateTime? @db.Timestamptz(3)
  deliveryDate    DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customerOrder   CustomerOrder? @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  items           ShipmentItem[]

  @@index([companyId, status])
  @@unique([companyId, id]) // composite-FK target for ShipmentItem.shipment
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("shipments")
}

enum ShipmentStatus {
  SHIPPED
  DELIVERED
}

// companyId denormalized from parent — see ProductionOrderPickListItem comment above.
model ShipmentItem {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  shipmentId     String   @db.Uuid
  finishedGoodId String   @db.Uuid

  company        Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  shipment       Shipment     @relation(fields: [companyId, shipmentId], references: [companyId, id], onDelete: Cascade) // composite — a shipment line has no meaning without its shipment
  finishedGood   FinishedGood @relation(fields: [companyId, finishedGoodId], references: [companyId, id]) // composite — kept Restrict (default): a shipped serial must always trace back to a real finished good

  @@index([shipmentId])
  @@index([companyId])
  @@map("shipment_items")
}

// ============================================================================
// SECTION: Procurement — Purchase Orders  (module: ProcurementModule) — PurchaseOrders.gs
// ============================================================================

model PurchaseOrder {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @db.Uuid
  supplierId            String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation); old system allowed a free-text supplier with no FK match (Phase 1 §10.6); migration backfills where confident, flags the rest
