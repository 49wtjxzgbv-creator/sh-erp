  productionWorkers ProductionOrderWorker[]
  payrollEntries    PayrollEntry[]

  @@index([companyId])
  @@unique([companyId, id]) // composite-FK target for ProductionOrderWorker.employee/PayrollEntry.employee
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("employees")
