// ============================================================================
// SECTION: Marketing — Landing Page  (module: LandingPageModule +
// SuperAdminModule's landing-page-admin.* files) — the public homepage's
// content, entirely Super-Admin-editable, no code deploy required to change
// a headline/FAQ/screenshot. Global model, no companyId — same reasoning as
// Plan above: this content belongs to the platform, not to any one tenant.
//
// Versioning mirrors AssemblyVersion's immutable, append-only snapshot
// philosophy (see BOM section) rather than a live "isDraft flag on one
// row" design: every row that has ever been PUBLISHED stays exactly as it
// was published, forever, as its own row — publishing again archives the
// old PUBLISHED row and inserts a brand new one, never an in-place update.
// The single DRAFT row is the deliberate exception (it IS mutated in place
// while an admin is actively editing) — enforced, along with "at most one
// PUBLISHED row", by two hand-written partial unique indexes in this
// model's migration (Prisma has no declarative attribute for a partial
// unique index, so this is raw SQL bolted onto the generated migration,
// same "Prisma limitation, hand-written SQL" pattern already used for
// AssemblyComponent's CHECK constraint elsewhere in this schema).
//
// `content` is deliberately one Json blob covering all 4 locales at once
// (e.g. `headline: { uk, en, pl, de }`) rather than 4 separate rows or a
// relational per-section/per-locale table set — the whole page is read
// wholesale on every homepage request and edited wholesale in the admin
// editor, so normalizing it into a dozen small tables would add real
// complexity (their own ordering/visibility columns, their own migrations)
// for no query this feature actually needs to run.
// ============================================================================

enum LandingPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LandingPageVersion {
  id            String            @id @default(uuid()) @db.Uuid
  status        LandingPageStatus @default(DRAFT)
  versionNumber Int? // null for the DRAFT row; assigned sequentially (1, 2, 3...) only at publish time, never reused
  content       Json // LandingPageContent shape (backend/src/modules/landing-page/landing-page-content.types.ts) — hero/modules/showcase/benefits/pricing/faq/contact/footer/seo, each field keyed by locale
  createdById   String            @db.Uuid
  publishedById String?           @db.Uuid // who actually clicked Publish; null until this row is promoted from draft

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3) // only ever changes while status = DRAFT
  publishedAt DateTime? @db.Timestamptz(3)

  createdBy   SuperAdmin  @relation("LandingPageVersionCreatedBy", fields: [createdById], references: [id])
  publishedBy SuperAdmin? @relation("LandingPageVersionPublishedBy", fields: [publishedById], references: [id])

  @@index([status])
  @@map("landing_page_versions")
}

// Marketing images (hero screenshot, the 8-step showcase's screenshots, OG
// image) — a small dedicated model rather than reusing FileAsset:
// FileAsset.companyId is required/tenant-scoped (files module, see its own
// header comment), and this content is company-independent, so it needs its
// own tiny presigned-upload flow (landing-page-media.service.ts) reusing
// the same r2-client.ts primitives directly instead.
model LandingMediaAsset {
  id           String    @id @default(uuid()) @db.Uuid
  storageKey   String // R2 key: marketing/landing/{uuid}-{filename} — no companyId segment, genuinely global
  originalName String
  mimeType     String
  sizeBytes    Int
  altText      Json? // { uk, en, pl, de } — optional per-locale alt text
  uploadedById String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3) // soft delete, same convention as FileAsset

  uploadedBy SuperAdmin @relation(fields: [uploadedById], references: [id])

  @@map("landing_media_assets")
}

// ============================================================================
// SECTION: Migration tracking  (Phase 4 tooling support — not a business module)
// ============================================================================

model LegacyMigrationRun {
  id                   String             @id @default(uuid()) @db.Uuid
  companyId            String             @db.Uuid
  status               MigrationRunStatus @default(EXTRACTING)
  sourceDeploymentId   String? // old Apps Script deployment identifier
  reconciliationReport Json? // row counts, sum checks, checksum results (Phase 2 §12.5)
  startedAt            DateTime           @default(now()) @db.Timestamptz(3)
  completedAt          DateTime?          @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("legacy_migration_runs")
}

enum MigrationRunStatus {
  EXTRACTING
  TRANSFORMING
  LOADING
  VERIFYING
  COMPLETED
  FAILED
}

// Universal data-import platform (2026-08-07 build, revised into a
// provider-agnostic architecture same day after review) — distinct from
// `LegacyMigrationRun` above, which is the `migration-toolkit` CLI's own
// tracking row for a Sheets-API, new-company-creation migration run (never
// driven from the app itself). A company connects one or more external data
// sources ("connectors") via `ImportConnection`, then runs one or more
// `ImportJob`s against a given connection. The Google Apps Script connector
// is the first of possibly several future providers (Excel/CSV upload, 1C,
// BAS, Odoo, ...) — see `backend/src/modules/legacy-import/providers/` for
// the provider interface every connector type implements; nothing in this
// schema is Apps-Script-specific.
//
// Auth model: NOT "the URL is the secret" (deliberately rejected — a URL
// passes through too many hands, e.g. clipboard/screenshots/browser
// history/this very database, to serve as a bearer credential with no way
// to revoke it selectively). Instead, a device-pairing handshake (same
// shape as `gh auth login` / smart-TV Google sign-in): SH ERP generates a
// short-lived, one-time `pairingCode`; the user enters it into the
// CONNECTOR'S OWN runtime UI (a native `ui.prompt()` dialog inside the
// Google Sheet, added by the connector's own `onOpen` menu — never inside
// the `.gs` source, so the user is never editing code). The connector then
// calls SH ERP directly with that code and its own URL
// (`ScriptApp.getService().getUrl()`), and SH ERP mints a real
// high-entropy `connectionToken` in response — this token, not the URL, is
// the actual bearer credential from then on, independently revocable per
// connection.
model ImportConnection {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @db.Uuid
  providerType String // 'GOOGLE_APPS_SCRIPT' today — plain string (not a Postgres enum) validated against the app-level provider registry, so a future provider is addable without a schema migration
  label        String // user-facing name, e.g. "Головна таблиця" — a company can have several connections at once

  configEncrypted String? // provider-specific JSON blob (for Apps Script: {webAppUrl, connectionToken}), AES-256-GCM envelope-encrypted (same scheme as CompanyAiSettings.apiKeyEncrypted, backend/src/modules/ai/ai-crypto.util.ts) — null while still PENDING pairing
  status          ImportConnectionStatus @default(PENDING)

  pairingCode          String? // set while PENDING, cleared once PAIRED; one-time use
  pairingCodeExpiresAt DateTime? @db.Timestamptz(3)

  protocolVersion  String? // last-seen connector protocol version (handshake/health-check) — compatibility diagnostics, see SUPPORTED_PROTOCOL_VERSIONS
  connectorVersion String? // last-seen connector's own self-reported version string, display-only

  lastHealthCheckAt DateTime? @db.Timestamptz(3)
  lastHealthStatus  Json? // last ConnectorHealth result (reachable, capabilities, diagnostics[]) — shown in the connections list

  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  pairedAt        DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  importJobs ImportJob[]

  @@index([companyId])
  @@map("import_connections")
}

enum ImportConnectionStatus {
  PENDING
  PAIRED
  REVOKED
}

model ImportJob {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @db.Uuid
  connectionId String          @db.Uuid
  status       ImportJobStatus @default(PENDING)
  step         String? // "fetching" | "transforming" | "loading" | "importing_photos" | "verifying" — human-readable substage within `status`, shown in the wizard's progress bar

  dryRun Boolean @default(false) // true = validate-only run, never writes business data

  totalPhotos     Int?
  processedPhotos Int  @default(0)

  warnings     Json? // TransformWarning[] — non-blocking, per-row data-quality notes
  errors       Json? // NEW: blocking, structural problems (missing required sheet, unsupported protocol version, failed health check) — distinct from warnings; a non-empty errors[] on the connection's most recent dry run blocks starting a real import (checked both client-side and server-side)
  report       Json? // full ImportReport: per-entity total/create/update/skip/failed counts, conflicts, photosDiscovered/Missing — see legacy-import.service.ts
  errorMessage String?

  durationMs Int? // completedAt - createdAt, computed on completion, surfaced directly rather than making the UI re-derive it

  startedByUserId String @db.Uuid

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  connection ImportConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([connectionId, createdAt])
  @@map("import_jobs")
}

enum ImportJobStatus {
  PENDING
  FETCHING
  TRANSFORMING
  LOADING
  IMPORTING_PHOTOS
  VERIFYING
  COMPLETED
  FAILED
}
