  status                PurchaseOrderStatus @default(ORDERED)
  orderDate             DateTime @default(now()) @db.Timestamptz(3)
  expectedDeliveryDate  DateTime? @db.Timestamptz(3)
  comment               String?
  sourceCustomerOrderId String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation)
  createdById           String   @db.Uuid

  legacyId              String?

  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  company               Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier              Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sourceCustomerOrder   CustomerOrder? @relation(fields: [sourceCustomerOrderId], references: [id], onDelete: SetNull)
  items                 PurchaseOrderItem[]

  @@index([companyId, status])
  @@unique([companyId, id]) // composite-FK target for PurchaseOrderItem.purchaseOrder
  @@unique([companyId, legacyId]) // idempotent migration load (Phase 4 §6)
  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIAL
  DELIVERED
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  purchaseOrderId String   @db.Uuid
  productId       String?  @db.Uuid // single-column FK — see header §cross-tenant (optional relation); old system allowed ordering an article not yet in Products (Phase 1 §10.7)
  articleSnapshot String
  productNameSnapshot String
  qtyOrdered      Decimal  @db.Decimal(14, 3)
  qtyReceived     Decimal  @default(0) @db.Decimal(14, 3)
  expectedPrice   Decimal? @db.Decimal(14, 2)
  actualPrice     Decimal? @db.Decimal(14, 2)

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder @relation(fields: [companyId, purchaseOrderId], references: [companyId, id], onDelete: Cascade) // composite — a PO line has no meaning without its order
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([companyId])
  @@map("purchase_order_items")
}

// ============================================================================
// SECTION: HR  (module: HrModule) — Employees.gs, Payroll.gs
// ============================================================================

model Employee {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  fullName  String
  position  String?
  phone     String?
  hireDate  DateTime? @db.Timestamptz(3)
  status    EmployeeStatus @default(ACTIVE) // deactivate only, never hard-delete (Phase 1 §3.5) — preserved as policy here too
  notes     String?

  legacyId  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

